# Only maintain the native port, not downloaded resources or local user data.
/*
!/.gitignore
!/README.md
!/README.zh-CN.md
!/LICENSE
!/Brewfile
!/project.json
!/.github/
!/scripts/
!/patches/
/patches/*
!/patches/native-arm64.patch

