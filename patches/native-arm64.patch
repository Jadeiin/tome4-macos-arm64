+static bool updateScreenInfo(void)
+{
+	int width, height, points_width;
+	SDL_GL_GetDrawableSize(window, &width, &height);
+	SDL_GetWindowSize(window, &points_width, NULL);
+	float scale = (float)width / points_width;
+	bool changed = !screen || screen->w != width || screen->h != height || window_scale != scale;
+	window_scale = scale;
+	if (!screen || screen->w != width || screen->h != height) {
+		SDL_FreeSurface(screen);
+		screen = SDL_CreateRGBSurface(0, width, height, 32, 0, 0, 0, 0);
+		if (!screen) { fprintf(stderr, "Screen allocation failed: %s\n", SDL_GetError()); exit(1); }
+	}
+	return changed;
 }
 
